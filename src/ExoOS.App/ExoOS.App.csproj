<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ExoOS</AssemblyName>
    <RootNamespace>ExoOS</RootNamespace>
    <Version>1.0.1</Version>
    <Product>ExoOS</Product>
    <Company>ImAvgErix</Company>
    <Authors>ImAvgErix</Authors>
    <Copyright>Copyright (c) 2026 Erix (ImAvgErix)</Copyright>
    <Description>ExoOS — deep Windows gaming transform. Balanced safe ceiling or Extreme barebones. Exo design system shell.</Description>
    <ApplicationIcon>Assets\ExoOS.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
    <ProjectReference Include="..\ExoForge.Engine\ExoForge.Engine.csproj" />
    <ProjectReference Include="..\ExoForge.Schema\ExoForge.Schema.csproj" />
  </ItemGroup>
  <!-- Ship playbook next to ExoOS.exe -->
  <ItemGroup>
    <Content Include="..\..\playbooks\exoos\**\*.*">
      <Link>playbooks\exoos\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Ship React shell -->
  <ItemGroup>
    <Content Include="wwwroot\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
